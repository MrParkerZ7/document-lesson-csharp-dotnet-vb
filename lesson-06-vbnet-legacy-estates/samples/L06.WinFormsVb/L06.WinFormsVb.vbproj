<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only VB desktop app: build-only in verify_samples (OutputType WinExe) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>L06.WinFormsVb</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\L06.ModernRating\L06.ModernRating.csproj" />
  </ItemGroup>
</Project>

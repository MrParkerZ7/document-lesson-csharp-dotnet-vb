<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- one feed, and every package id mapped to it: no dependency confusion, no NU1507 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

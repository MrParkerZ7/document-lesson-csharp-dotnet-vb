{
  "Identity": {
    "Authority": "https://login.example.test/tenant-l11/v2.0",
    "Audience": "api://l11-secure-quote-api"
  },
  "ReverseProxy": {
    "Routes": {
      "quotes": {
        "ClusterId": "quote-api",
        "AuthorizationPolicy": "customer-api",
        "Match": { "Path": "/api/quotes/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "underwriting": {
        "ClusterId": "quote-api",
        "AuthorizationPolicy": "underwriting",
        "Match": { "Path": "/api/underwriting/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "health": {
        "ClusterId": "quote-api",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/health" }
      }
    },
    "Clusters": {
      "quote-api": {
        "Destinations": { "primary": { "Address": "http://quote-api.example.test:8080/" } }
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Warning" } }
}

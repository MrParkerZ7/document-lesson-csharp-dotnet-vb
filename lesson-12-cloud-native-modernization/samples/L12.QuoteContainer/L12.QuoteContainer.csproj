<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- chiseled images carry no ICU: the app must run globalization-invariant -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- read by: dotnet publish -c Release /t:PublishContainer  (no Dockerfile) -->
  <PropertyGroup>
    <ContainerRepository>motorquote/quote-api</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <ContainerImageTags>1.0.0;latest</ContainerImageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\L12.RatingVb\L12.RatingVb.vbproj" />
  </ItemGroup>
</Project>
